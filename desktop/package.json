{
  "name": "klm-sender",
  "productName": "KLM Sender",
  "version": "1.0.0",
  "description": "Kirim file apa saja antar PC dan HP, ukuran asli tanpa kompres.",
  "main": "main.js",
  "author": "KLM",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.klm.sender",
    "productName": "KLM Sender",
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "icon": "build/icon.ico", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "KLM Sender", "artifactName": "KLM-Sender-Setup-${version}.exe" },
    "portable": { "artifactName": "KLM-Sender-Portable-${version}.exe" }
  }
}
